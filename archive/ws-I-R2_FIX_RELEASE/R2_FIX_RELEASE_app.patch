diff --git a/src/shared/components/RuntimeConnection/setupState.ts b/src/shared/components/RuntimeConnection/setupState.ts
new file mode 100644
index 0000000000000000000000000000000000000000..89988ce36054fa739cfaa5d848a087c717e5d1a7
--- /dev/null
+++ b/src/shared/components/RuntimeConnection/setupState.ts
@@ -0,0 +1,66 @@
+/** Browser intent survives component handoffs even when durable storage is blocked. */
+export interface SetupChoices {
+  readonly autostart: boolean;
+  readonly command: boolean;
+  readonly skills: boolean;
+  readonly skillCopies: boolean;
+}
+export const RECOMMENDED_SETUP_CHOICES: SetupChoices = Object.freeze({ autostart: true, command: true, skills: true, skillCopies: false });
+export interface PendingSetupState {
+  readonly alreadySetUp: boolean;
+  readonly choices: SetupChoices;
+  readonly changed?: readonly (keyof SetupChoices)[];
+}
+const KEY = 'astrid:pending-setup-v1';
+const CONNECTED_KEY = 'astrid.runtime.connectedBefore';
+let connectedInVisit = false;
+const keys = ['autostart', 'command', 'skills', 'skillCopies'] as const;
+let memory: PendingSetupState | undefined;
+let memoryFallback = false;
+let visitConsent: boolean | undefined;
+let lastWrittenRaw: string | undefined;
+export function hasPendingSetupState(): boolean {
+  if (memoryFallback) return memory !== undefined;
+  try { return localStorage.getItem(KEY) !== null; } catch { return memory !== undefined; }
+}
+export function readPendingSetupState(): PendingSetupState {
+  if (memoryFallback && memory) return memory;
+  try {
+    const raw = localStorage.getItem(KEY);
+    if (raw !== lastWrittenRaw) visitConsent = undefined;
+    memory = undefined;
+    if (raw) {
+      const value = JSON.parse(raw) as PendingSetupState;
+      if (typeof value.alreadySetUp === 'boolean' && value.choices && keys.every(key => typeof value.choices[key] === 'boolean')) {
+        memory = { ...value, changed: value.changed?.filter(key => keys.includes(key)) ?? keys.filter(key => value.choices[key] !== RECOMMENDED_SETUP_CHOICES[key]) };
+      }
+    }
+  } catch { /* Use the current visit's intent. */ }
+  return memory ?? { alreadySetUp: false, choices: RECOMMENDED_SETUP_CHOICES, changed: [] };
+}
+export function writePendingSetupState(value: PendingSetupState, consentEdited = false): void {
+  memory = value;
+  if (consentEdited) visitConsent = value.alreadySetUp;
+  const raw = JSON.stringify(value);
+  try { localStorage.setItem(KEY, raw); lastWrittenRaw = raw; memoryFallback = false; }
+  catch { memoryFallback = true; }
+}
+export function readVisitSetupConsent(): boolean | undefined { return visitConsent; }
+export function completePendingSetup(): void {
+  const pending = readPendingSetupState();
+  visitConsent = undefined;
+  writePendingSetupState({ ...pending, alreadySetUp: true, changed: [] });
+}
+
+export function readConnectedBefore(): boolean {
+  try { connectedInVisit = localStorage.getItem(CONNECTED_KEY) === '1'; } catch { /* Same visit memory. */ }
+  return connectedInVisit;
+}
+export function writeConnectedBefore(): void {
+  connectedInVisit = true;
+  completePendingSetup();
+  try { localStorage.setItem(CONNECTED_KEY, '1'); } catch { /* Same visit memory. */ }
+}
+export function rememberedSetup(): boolean {
+  return readPendingSetupState().alreadySetUp || readConnectedBefore();
+}
