+
+
+def test_strict_update_from_frozen_package_removes_legacy_hermes_registration(tmp_path, monkeypatch):
+    from tests.installer_skill_fixtures import frozen_agent_source
+    from astrid.installer.backend import Backend
+    from astrid.skills import disable_owned, state
+
+    env = _skill_app_update(tmp_path, monkeypatch)
+    disable_owned()
+    frozen_source = frozen_agent_source(tmp_path)
+    previous = env.version("frozen", 11, package_source=frozen_source)
+    env.old = previous
+    switch(env.root, previous)
+    env.backend.persist_identity(previous)
+    # Seed through the actual frozen package and production subprocess boundary.
+    Backend.run(env.backend, [previous.python, "-X", "utf8", "-I", "-m", "astrid.skills", "install",
+        "foley", "--harness", "hermes", "--mechanism", "external-dir", "--json"], extra_env=previous.env)
+    assert "external_entry" not in state.load()["installs"]["hermes"]["foley"]
+    config = env.home / ".hermes/config.yaml"
+    old_entry = str(frozen_source / "astrid/packs")
+    config.write_bytes(config.read_bytes() + b"  - /foreign/skills # keep this registration\n")
+    saved = env.backend.service.recorded()["choices"]
+    env.backend.service.choices = {**saved, "skills": False}
+    result = update.update_app(env.root, env.backend, {"release": 12}, say=lambda _: None)
+    assert current(env.root) == env.candidate
+    assert result["skills"]["ok"]
+    assert old_entry.encode() not in config.read_bytes()
+    assert b"/foreign/skills # keep this registration" in config.read_bytes()
+    assert not state.load()["installs"]["hermes"]
+    assert env.backend.service.recorded()["choices"]["skills"] is False
+    assert read_json(env.root / "update-transaction.json")["step"] == "complete"
