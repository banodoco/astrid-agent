+def frozen_agent_source(tmp_path):
+    """Materialize the exact frozen installed package, without a scratch clone."""
+    import io
+    import subprocess
+    import tarfile
+
+    source = tmp_path / "frozen-agent-source"
+    source.mkdir()
+    archive = subprocess.check_output(["git", "-C", str(Path(astrid.__file__).resolve().parent.parent),
+        "archive", "12f401eb8f707234697672317c8995a4637dc54d", "astrid"])
+    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
+        tar.extractall(source, filter="data")
+    return source
