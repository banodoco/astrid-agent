+def test_hermes_external_dir_off_uses_receipt_across_source_root_transition(tmp_path, monkeypatch):
+    from astrid.skills.harnesses import hermes as hermes_harness
+
+    fx = _Tmp()
+    try:
+        old_packs = tmp_path / "old-package" / "astrid" / "packs"
+        new_packs = tmp_path / "new-package" / "astrid" / "packs"
+        old_packs.mkdir(parents=True)
+        new_packs.mkdir(parents=True)
+        monkeypatch.setattr(hermes_harness, "PACKS_DIR_FOR_EXTERNAL", old_packs)
+        skills.install(["foley"], ["hermes"], mechanism="external-dir", state_path=fx.state_path)
+        config = fx.home / ".hermes" / "config.yaml"
+        old_entry = str(old_packs.resolve())
+        assert old_entry in (yaml.safe_load(config.read_text()) or {})["skills"]["external_dirs"]
+
+        # The installed package is upgraded/replaced and the current adapter
+        # now points at a different source tree.
+        monkeypatch.setattr(hermes_harness, "PACKS_DIR_FOR_EXTERNAL", new_packs)
+        report = skills.disable_owned(state_path=fx.state_path)
+
+        assert old_entry not in (yaml.safe_load(config.read_text()) or {})["skills"]["external_dirs"]
+        assert any(old_entry in row["removed"] for row in report["actions"])
+        assert "foley" not in state.load(fx.state_path)["installs"].get("hermes", {})
+    finally:
+        fx.close()
+
+
+@pytest.mark.parametrize("mechanism", ["copy", "symlink"])
+def test_hermes_external_dir_transition_to_managed_target_then_off_cleans_both(tmp_path, mechanism):
+    fx = _Tmp()
+    try:
+        skills.install(["foley"], ["hermes"], mechanism="external-dir", state_path=fx.state_path)
+        config = fx.home / ".hermes" / "config.yaml"
+        external_entry = str(PACKS_DIR_FOR_EXTERNAL.resolve())
+
+        skills.sync(harness_names=["hermes"], mechanism=mechanism, state_path=fx.state_path)
+        assert external_entry not in (yaml.safe_load(config.read_text()) or {})["skills"]["external_dirs"]
+
+        skills.disable_owned(state_path=fx.state_path)
+        assert external_entry not in (yaml.safe_load(config.read_text()) or {})["skills"]["external_dirs"]
+        target = HermesAdapter().target_for(next(d for d in _descriptors() if d.pack_id == "foley"))
+        assert not target.exists() and not target.is_symlink()
+        assert not state.load(fx.state_path)["installs"].get("hermes")
+    finally:
+        fx.close()
+
+
+def test_public_hermes_uninstall_removes_external_dir_registration(tmp_path):
+    fx = _Tmp()
+    try:
+        skills.install(["foley"], ["hermes"], mechanism="external-dir", state_path=fx.state_path)
+        config = fx.home / ".hermes" / "config.yaml"
+        entry = str(PACKS_DIR_FOR_EXTERNAL.resolve())
