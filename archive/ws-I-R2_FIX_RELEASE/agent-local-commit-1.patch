+def test_doctor_healed_hermes_external_dir_receipt_can_be_turned_off(tmp_path):
+    fx = _Tmp()
+    try:
+        skills.install(["foley"], ["hermes"], mechanism="external-dir", state_path=fx.state_path)
+        config = fx.home / ".hermes" / "config.yaml"
+        entry = str(PACKS_DIR_FOR_EXTERNAL.resolve())
+        current = state.load(fx.state_path)
+        current["installs"]["hermes"] = {}
+        state.save(current, fx.state_path)
+
+        healed = skills.doctor(state_path=fx.state_path, heal=True)
+        assert any(row.get("harness") == "hermes" and row.get("action") == "recorded-from-fs"
+                   for row in healed["healed"])
+        receipt = state.load(fx.state_path)["installs"]["hermes"]["foley"]
+        assert receipt["target"] == str(config)
+        assert receipt["mechanism"] == "external-dir"
+
+        report = skills.disable_owned(state_path=fx.state_path)
+
+        assert entry not in (yaml.safe_load(config.read_text()) or {})["skills"]["external_dirs"]
+        assert "foley" not in state.load(fx.state_path)["installs"].get("hermes", {})
+        assert not report.get("conflicts")
+    finally:
+        fx.close()
+
