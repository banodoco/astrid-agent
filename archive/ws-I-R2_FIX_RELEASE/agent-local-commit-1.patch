+def test_failed_off_choices_summary_reports_unreached_effects_and_valid_uninstall(capsys):
+    choices = {name: False for name in RECOMMENDED_CHOICES}
+    cli._print_run_summary(choices, mode="update", outcomes={"startup": "not confirmed"},
+                           failure=RuntimeError("staging failed"))
+    output = capsys.readouterr().out
+    assert "Startup: not confirmed" in output
+    assert "Command/PATH: not reached" in output
+    assert "This run may not have applied that choice" in output
+    assert "Startup recovery: Astrid will not start at sign-in" not in output
+    assert "the astrid command shim is off" not in output
+    assert "replace all setup/update arguments with --uninstall" in output
+    cli.parser().parse_args(["--uninstall"])
+
+
+def test_preserved_command_summary_does_not_claim_shim_is_off(capsys):
+    cli._print_run_summary({**RECOMMENDED_CHOICES, "command": False}, mode="update",
+        outcomes={"command": {"action": "disabled", "preserved_shim": True}})
+    output = capsys.readouterr().out
+    assert "Command/PATH: cleanup incomplete" in output
+    assert "shim preserved" in output
+    assert "Command/PATH: off" not in output
