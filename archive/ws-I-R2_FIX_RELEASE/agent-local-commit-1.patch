+def test_sync_check_detects_saved_copy_policy_mismatch_without_writing(tmp_path, capsys):
+    from astrid.skills import state
+    from astrid.installer.core import write_json
+    from astrid.installer.service import LABEL, install_selection
+    import sys
+    import shutil
+
+    home = Path.home()
+    (home / ".claude").mkdir(exist_ok=True)
+    selection = install_selection(home, sys.platform)
+    write_json(selection, {"owner": LABEL, "program_root": str(tmp_path / "app"),
+        "choices": {"skills": True, "skill_copies": True}})
+    assert cli.main(["sync", "--harness", "claude", "--json"]) == 0
+    capsys.readouterr()
+    target = home / ".claude/skills/astrid"
+    source = json.loads((target / ".astrid-managed-skill.json").read_text())["source"]
+    shutil.rmtree(target)
+    target.symlink_to(source, target_is_directory=True)
+    before = state.state_path().read_bytes()
+    assert cli.main(["sync", "--check", "--json"]) == 1
+    report = json.loads(capsys.readouterr().out)
+    assert any(row["harness"] == "claude" and row["mechanism"] == "copy" for row in report["policy_mismatches"])
+    assert state.state_path().read_bytes() == before
