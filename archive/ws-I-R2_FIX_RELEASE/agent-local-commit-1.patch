+@pytest.mark.parametrize("explicit", [False, True])
+def test_public_sync_check_honors_off_policy_and_is_read_only(tmp_path, monkeypatch, capsys, explicit):
+    home = Path.home()
+    for harness in ("claude", "codex", "hermes"):
+        (home / f".{harness}").mkdir(exist_ok=True)
+    monkeypatch.setenv("ASTRID_STATE_HOME", str(tmp_path / "state-home"))
+    record_path = service.install_selection(home, sys.platform)
+    service.write_json(
+        record_path,
+        {
+            "owner": service.LABEL,
+            "program_root": str(tmp_path / "program"),
+            "choices": {"skills": explicit, "skill_copies": True},
+        },
+    )
+    state_path = state.state_path()
+    state_path.parent.mkdir(parents=True, exist_ok=True)
+    state.save(state._empty_state(), state_path)
+    state_bytes = state_path.read_bytes()
+    install_record_bytes = record_path.read_bytes()
+    args = ["sync"] + (["--skills", "off"] if explicit else []) + ["--check", "--json"]
+
+    assert cli.main(args) == 0
+    report = json.loads(capsys.readouterr().out)
+    assert report["has_drift"] is False
+    assert report["missing"] == []
+    assert state_path.read_bytes() == state_bytes
+    assert record_path.read_bytes() == install_record_bytes
+    for harness in ("claude", "codex", "hermes"):
+        assert not (home / f".{harness}" / "skills" / "astrid").exists()
