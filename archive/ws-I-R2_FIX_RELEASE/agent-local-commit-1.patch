+@pytest.mark.parametrize("saved_skills", [False, True])
+def test_public_developer_uninstall_resync_uses_saved_off_or_copy_policy(
+    tmp_path, capsys, saved_skills
+):
+    home = Path.home()
+    (home / ".claude").mkdir(exist_ok=True)
+    record_path = service.install_selection(home, sys.platform)
+    service.write_json(
+        record_path,
+        {
+            "owner": service.LABEL,
+            "program_root": str(tmp_path / "program"),
+            "choices": {"skills": saved_skills, "skill_copies": True},
+        },
+    )
+
+    # Developer installation is an explicit opt-in even when the saved
+    # managed-skills choice is off. The later uninstall resync must use the
+    # saved policy, rather than recreating the default view behind the CLI.
+    assert cli.main(["install", "--developer", "--harness", "claude", "--json"]) == 0
+    capsys.readouterr()
+    core_target = home / ".claude" / "skills" / "astrid"
+    assert core_target.is_dir() and not core_target.is_symlink()
+    assert json.loads(record_path.read_text())["choices"]["skills"] is saved_skills
+
+    assert cli.main(["uninstall", "--developer", "--harness", "claude", "--json"]) == 0
+    report = json.loads(capsys.readouterr().out)
+    assert "resync" in report
+    if saved_skills:
+        assert core_target.is_dir() and not core_target.is_symlink()
+        assert (core_target / ".astrid-managed-skill.json").is_file()
+    else:
+        assert not core_target.exists() and not core_target.is_symlink()
+        assert json.loads(record_path.read_text())["choices"]["skills"] is False
+
