{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.local/schemas/astrid-intent/astrid-intent.schema.json",
  "title": "AstridIntent",
  "description": "Astrid's editing intent inside the shared timeline schema (A1, platform ruling R-5: Astrid semantics only under app.astrid). clipIntent is the object at clip.app.astrid; filmIntent is the object at parent.config.app.astrid. Shape matches astrid/core/timeline/astrid_ns.py (CLIP_INTENT_KEYS, FILM_INTENT_KEYS, _keep) and astrid/sdk/timeline_intent.py. Legacy locations (flat clip.app keys, loose parent.config keys) are NOT validated here: they are read through the dual reader and moved by migrate. Clashing legacy values live under _legacy (key, then key#2, key#3, ...).",
  "$defs": {
    "legacyValues": {
      "type": "object",
      "description": "A legacy value that differed from the namespace's own value, kept by _keep under the key it came from (key#2, key#3 ... when that slot is taken).",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(#[0-9]+)?$"
      },
      "additionalProperties": true
    },
    "beatGrid": {
      "type": "object",
      "description": "A beat grid as stored by beats_grid(): times in SOURCE seconds of the music file (time: cue_seconds). Hits are [t] or [t, kind].",
      "properties": {
        "bpm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_s": {
          "type": "number"
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "downbeats": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "hits": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2
          }
        },
        "time": {
          "type": "string",
          "enum": [
            "cue_seconds"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "beats"
      ],
      "additionalProperties": false
    },
    "clipIntent": {
      "$comment": "Object at clip['app']['astrid']. Known keys mirror astrid_ns.CLIP_INTENT_KEYS; additionalProperties is false because the module owns every key it writes.",
      "type": "object",
      "properties": {
        "on": {
          "type": "string",
          "description": "Start moment, e.g. \"viral\", \"beat 2 after \\\"Astrid\\\"\", \"+0.8s\"."
        },
        "until": {
          "type": "string",
          "description": "End moment, e.g. \"Astrid\" or a cut id."
        },
        "for": {
          "type": "number",
          "description": "A literal length in seconds."
        },
        "cut": {
          "type": "string",
          "description": "Cut id (c21); ids, not positions."
        },
        "layer": {
          "type": "string",
          "description": "Layer short name inside its cut."
        },
        "deliberate_hold": {
          "type": "boolean",
          "description": "Written by set_deliberate (true) or removed."
        },
        "deliberate": {
          "type": "boolean",
          "description": "Legacy spelling; read as an alias of deliberate_hold, dropped on write."
        },
        "why": {
          "type": "string"
        },
        "why_layers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formulas": {
          "type": "object",
          "description": "{field path: expression}, e.g. {\"params.x\": {\"word\": \"viral\", \"field\": \"start\"}}.",
          "additionalProperties": {
            "type": "object"
          }
        },
        "segment": {
          "type": "string",
          "description": "VO line (segment id) this audio clip belongs to."
        },
        "words": {
          "type": "array",
          "description": "Spoken words as [start, end, text] rows, seconds from the clip's start.",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3
          }
        },
        "text": {
          "type": "string",
          "description": "The line's script text as written."
        },
        "gap_after_s": {
          "type": "number",
          "minimum": 0,
          "description": "Declared silence after the line."
        },
        "beats": {
          "description": "A beat grid (beatGrid), or the older clip-relative list of beat times.",
          "oneOf": [
            {
              "$ref": "#/$defs/beatGrid"
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "minItems": 1
                  }
                ]
              }
            }
          ]
        },
        "slot": {
          "type": "string",
          "description": "Real-footage slot id."
        },
        "replaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standin_for": {
          "type": "string",
          "description": "A file path or registry key not available yet."
        },
        "intended": {
          "type": "object",
          "description": "{element, params} for a stand-in."
        },
        "sequence": {
          "description": "V3 sequence id/index pair written by set_sequence; legacy id string remains readable with sequence_index.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "index"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0
        },
        "sequence_fit": {
          "type": "object",
          "description": "How a sequence lays its steps against the voice (land, lead, race, cycle, then)."
        },
        "orphan": {
          "type": "string",
          "description": "Why this clip is an orphan."
        },
        "role": {
          "type": "string",
          "enum": [
            "plate",
            "footage",
            "presenter",
            "sprite",
            "label",
            "title",
            "caption",
            "card",
            "chrome",
            "transition",
            "voice",
            "music",
            "sfx"
          ],
          "description": "The tag verb's role (ROLE_VOCABULARY in astrid/sdk/timeline/selection.py)."
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "duck": {
          "type": "object",
          "description": "The duck rule mapping (tag verb)."
        },
        "_legacy": {
          "$ref": "#/$defs/legacyValues"
        },
        "copy_quotes": {
          "$ref": "#/$defs/copyQuotes"
        },
        "copy_quote_tracking": {
          "type": "object",
          "description": "Command-owned correspondence/invalidation evidence keyed by declaration content digest. Declarations retain their captured source basis.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "unavailable"
                ]
              },
              "source": {
                "$ref": "#/$defs/copySource"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "status",
              "source",
              "reasons"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "filmIntent": {
      "$comment": "Object at parent.config['app']['astrid']. Known keys mirror astrid_ns.FILM_INTENT_KEYS.",
      "type": "object",
      "properties": {
        "v": {
          "type": "integer",
          "description": "Astrid writer compatibility version; absent is legacy 0. Writer support is checked at commit."
        },
        "chapters": {
          "type": "array",
          "description": "Labels over runs of cuts: each chapter starts at a cut.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "from": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "from"
            ]
          }
        },
        "slots": {
          "type": "object",
          "description": "Slot table {id: {kind, spec, face_zone, hand_mark, media}}.",
          "additionalProperties": {
            "type": "object"
          }
        },
        "cut_notes": {
          "type": "object",
          "description": "{cut id: {why, why_layers, hold}}; notes belong to the cut, not to a clip.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "why": {
                "type": "string"
              },
              "why_layers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hold": {
                "type": "string",
                "description": "e.g. \"deliberate\"."
              }
            },
            "additionalProperties": false
          }
        },
        "formulas": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "sequences": {
          "type": "object",
          "description": "Sequence table (listed in FILM_INTENT_KEYS; no writer in the module yet)."
        },
        "_legacy": {
          "$ref": "#/$defs/legacyValues"
        },
        "music_beds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/musicBed"
          },
          "description": "Authored source and current unsnapped ripple inputs; outputs are derived ownership mapping. Requires integer format v=2."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "music_beds"
            ]
          },
          "then": {
            "required": [
              "v"
            ],
            "properties": {
              "v": {
                "const": 2
              }
            }
          }
        }
      ]
    },
    "musicRipplePoint": {
      "type": "object",
      "required": [
        "at_s",
        "delta_s"
      ],
      "properties": {
        "at_s": {
          "type": "number"
        },
        "delta_s": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "musicBed": {
      "type": "object",
      "required": [
        "owner",
        "source",
        "ripple_basis",
        "outputs"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "ripple_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/musicRipplePoint"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "copyQuotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "const": 1
          },
          "normalization": {
            "const": "copy-token-v1"
          },
          "display": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^params\\.[A-Za-z_][\\w.-]*$"
              },
              "text": {
                "type": "string"
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "path",
              "text"
            ],
            "additionalProperties": false
          },
          "source": {
            "$ref": "#/$defs/copySource"
          }
        },
        "required": [
          "version",
          "normalization",
          "display",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "copySource": {
      "type": "object",
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_digest": {
          "type": "string",
          "minLength": 1
        },
        "occurrence_id": {
          "type": "string",
          "minLength": 1
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        },
        "clip": {
          "type": "string",
          "minLength": 1
        },
        "segment": {
          "type": "string",
          "minLength": 1
        },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "snapshot_kind": {
          "enum": [
            "detached-document-sha256"
          ]
        },
        "word_producer": {
          "type": "object",
          "properties": {
            "clip": {
              "type": "string",
              "minLength": 1
            },
            "words_digest": {
              "type": "string",
              "minLength": 1
            },
            "asset": {
              "type": [
                "string",
                "null"
              ]
            },
            "asset_dependency": {},
            "lexical_digest": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "clip",
            "words_digest",
            "asset",
            "asset_dependency",
            "lexical_digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "revision_id",
        "snapshot_digest",
        "occurrence_id",
        "binding_id",
        "content_hash",
        "clip",
        "segment",
        "words"
      ],
      "additionalProperties": false
    }
  }
}
