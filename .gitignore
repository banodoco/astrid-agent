# Secrets and local environment
.DS_Store
/HEAD
.env
.env.*
astrid.env
this.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*
*secret*
# These are safe reference docs, not credential material.
!docs/reference/credentials.md
!docs/reference/runpod-credentials.md
# Real source files whose names trip the broad credential globs above.
!astrid/core/util/secrets.py
!astrid/core/util/credentials_scope.py
!tests/core/test_credentials_scope.py
!tests/core/test_dataset_build_credentials_parity.py
!tests/core/util/test_secrets.py

# Python
__pycache__/
.venv/
venv/
*.py[cod]
.pytest_cache/
/.tmp-tests/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Node / Remotion
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
remotion/build/
remotion/out/

# Generated runtime artifacts
