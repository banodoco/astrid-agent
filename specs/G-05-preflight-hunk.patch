--- /dev/null
+++ b/tests/core/generation/test_qualification_preflight.py
@@ -0,0 +1,24 @@
+from types import SimpleNamespace
+
+import pytest
+
+from astrid.core.contracts.errors import AstridError
+from astrid.core.generation import availability
+from astrid.core.generation.preflight import validate_generation_request
+
+
+def test_qualification_preserves_matrix_checks_and_accepts_qualified_fake(monkeypatch):
+    mode = SimpleNamespace(backends={"local": object()}, requires=())
+    entry = SimpleNamespace(modality="video")
+    registry = SimpleNamespace(get_by_mode=lambda model, name: (entry, mode))
+    monkeypatch.setattr(availability, "availability_declaration", lambda: {"models": {
+        "blocked": {"available": False, "error": {"code": "generation_route_unqualified", "message": "not qualified"}},
+        "qualified": {"available": True},
+    }})
+    with pytest.raises(AstridError) as exc:
+        validate_generation_request(registry, model="blocked", mode="i2v", execution="local")
+    assert exc.value.code == "generation_route_unqualified" and exc.value.fix
+    assert validate_generation_request(registry, model="qualified", mode="i2v", execution="local") == (entry, mode)
+    from astrid.sdk.exceptions import CapabilityValidationError
+    with pytest.raises(CapabilityValidationError, match="not available"):
+        validate_generation_request(registry, model="blocked", mode="i2v", execution="cloud")
