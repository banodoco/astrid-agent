#!/usr/bin/env bash
# The one pre-push command (testing plan R-12): default test lane, then host/render change check.
# Run from anywhere in the repo before pushing; it cds to the repo root itself.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
else
  PY=python3
fi

"$PY" -m pytest -q

# Paths this push changes: commits on this branch vs origin/main (tolerated when
# origin/main is absent), plus uncommitted and untracked files.
CHANGED="$(
  {
    git diff --name-only origin/main...HEAD 2>/dev/null || true
    git diff --name-only HEAD
    git ls-files --others --exclude-standard
  } | sort -u
)"

HOST_RENDER_RE='^(astrid/core/execution/process_group\.py|astrid/sdk/autobootstrap\.py|astrid/packs/rendering/|remotion/)|(^|/)(custody_broker|task_scope|host_bootstrap|workspace_client)\.py$|(^|/)generic_host[^/]*\.py$'

if grep -Eq "$HOST_RENDER_RE" <<<"$CHANGED"; then
  echo 'Host/render paths changed: run `python -m astrid dev journey --tier smoke` before merging (testing plan R-11).'
fi
