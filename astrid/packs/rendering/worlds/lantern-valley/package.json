{
  "name": "lantern-valley-sample-world",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Lantern Valley, the built-in sample world for Astrid's Three.js Live Editor (World Explorer). See README.md.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node harness/check.mjs",
    "validate": "node harness/validate.mjs",
    "stills": "node harness/capture.mjs --out stills/timeline",
    "views": "node harness/views.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.0",
    "esbuild": "0.27.7",
    "typescript": "5.9.3"
  }
}
