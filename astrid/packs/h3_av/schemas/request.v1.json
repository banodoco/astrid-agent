{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/h3-av/request.v1.json",
  "title": "H3 audiovisual transformation request v1",
  "description": "H3 source-backed edit/continue and single-pass source-free image-reference generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operation", "content", "changes", "references", "overrides"],
  "allOf": [{
    "if": {"properties": {"operation": {"const": "generate"}}, "required": ["operation"]},
    "then": {
      "required": ["output"],
      "properties": {
        "source": {"type": "null"},
        "output": {"required": ["duration"], "properties": {"duration": {"minimum": 0.20833333333333334, "maximum": 15.083333333333334}}},
        "changes": {"properties": {"video": {"maxItems": 0}, "audio": {"maxItems": 0}}},
        "references": {"minItems": 1, "maxItems": 9, "items": {"properties": {"purpose": {"enum": ["appearance", "reference", "motion", "pose", "style", "first_frame", "keyframe"]}}}}
      }
    },
    "else": {"required": ["source"], "properties": {"source": {"type": "object"}}}
  }],
  "properties": {
    "version": {"const": 1},
    "operation": {"enum": ["edit", "continue", "generate"]},
    "source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["asset"],
      "properties": {
        "asset": {"type": "string", "minLength": 1},
        "range": {"$ref": "#/$defs/range"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"duration": {"type": "number", "exclusiveMinimum": 0}}
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {"prompt": {"type": "string", "minLength": 1}}
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "audio"],
      "properties": {
        "video": {"type": "array", "items": {"$ref": "#/$defs/video_change"}},
        "audio": {"type": "array", "items": {"$ref": "#/$defs/audio_change"}}
      }
    },
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string"},
        "steps": {"type": "integer", "minimum": 1, "maximum": 200},
        "seed": {"type": "integer", "minimum": 0},
        "sampler": {"type": "string"},
        "guidance": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "purpose"],
      "properties": {
        "asset": {"type": "string", "minLength": 1},
        "purpose": {"enum": ["appearance", "reference", "motion", "pose", "keyframe", "first_frame", "audio", "style"]},
        "position": {"type": "integer", "minimum": 0, "description": "Zero-based frame within requested output; keyframe conditions this frame, first_frame protects only the encoded latent at zero."}
      },
      "allOf": [
        {"if": {"properties": {"purpose": {"const": "keyframe"}}}, "then": {"required": ["position"]}},
        {"if": {"properties": {"purpose": {"const": "first_frame"}}}, "then": {"properties": {"position": {"const": 0}}}},
        {"if": {"properties": {"purpose": {"not": {"enum": ["first_frame", "keyframe"]}}}}, "then": {"not": {"required": ["position"]}}}
      ]
    },
    "area": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "full_frame": {"const": true},
        "mask_asset": {"type": "string", "minLength": 1},
        "subjects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rectangle": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "polygon": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
      }
    },
    "video_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["during", "area", "action"],
      "properties": {
        "during": {"$ref": "#/$defs/range"},
        "area": {"$ref": "#/$defs/area"},
        "action": {"enum": ["generate", "preserve"]},
        "mask_asset": {"type": "string"}
      }
    },
    "audio_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["during", "action"],
      "properties": {
        "during": {"$ref": "#/$defs/range"},
        "action": {"enum": ["generate", "preserve"]},
        "dialogue": {"type": "string"},
        "mask_asset": {"type": "string"},
        "stem": {"enum": ["mix", "voice", "effects", "music"]}
      }
    }
  }
}
