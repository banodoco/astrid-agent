{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/h3-av/request.v2.json",
  "title": "H3 audiovisual media-list request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "prompt", "media", "settings"],
  "properties": {
    "version": {"const": 2},
    "prompt": {"type": "string", "minLength": 1},
    "duration": {"type": ["number", "string"], "exclusiveMinimum": 0},
    "continuation": {"type": "boolean"},
    "settings": {"$ref": "#/$defs/settings"},
    "media": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/media"}}
  },
  "$defs": {
    "asset": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "asset": {"type": "string", "minLength": 1}, "modality": {"enum": ["image", "video", "audio"]}, "inspection": {"type": "object"}}}
      ]
    },
    "at": {"type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1, "properties": {"frame": {"type": "integer", "minimum": 0}, "seconds": {"type": ["number", "string"], "minimum": 0}}},
    "edit": {"type": "object", "additionalProperties": false, "required": ["stream"], "properties": {"stream": {"enum": ["video", "audio"]}, "during": {"type": "array", "minItems": 2, "maxItems": 2}, "mask": {}, "guides": {}, "text": {"type": "string"}, "dialogue": {"type": "string"}, "channels": {}, "action": {"enum": ["generate", "preserve"]}, "keep": {"type": "boolean"}}},
    "media": {"type": "object", "additionalProperties": false, "required": ["asset", "role"], "properties": {"id": {"type": "string", "minLength": 1}, "asset": {"$ref": "#/$defs/asset"}, "role": {"enum": ["timeline", "reference"]}, "modality": {"enum": ["image", "video", "audio"]}, "at": {"$ref": "#/$defs/at"}, "range": {"type": "array", "minItems": 2, "maxItems": 2}, "edit": {"type": "array", "items": {"$ref": "#/$defs/edit"}}, "audio": {"type": "boolean"}, "hard": {"type": "boolean"}, "latent_pin": {"type": "boolean"}}},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string"},
        "steps": {"type": "integer", "minimum": 1, "maximum": 200},
        "sampler": {"type": "string"},
        "scheduler": {"type": "string"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "guidance_scale": {"type": "number", "minimum": 0},
        "guidance": {"type": "number", "minimum": 0},
        "turbo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "strength": {"type": "number", "minimum": 0}
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"const": "character_swap_v1"},
            "strength": {"type": "number", "minimum": 0, "maximum": 2}
          }
        }
      },
      "allOf": [
        {"not": {"required": ["guidance", "guidance_scale"]}},
        {"not": {"properties": {"turbo": {"required": ["strength"]}}, "required": ["guidance", "turbo"]}},
        {"not": {"properties": {"turbo": {"required": ["strength"]}}, "required": ["guidance_scale", "turbo"]}},
        {"if": {"required": ["adapter"]}, "then": {"properties": {"model": {"const": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"}}}},
        {
          "if": {
            "properties": {"turbo": {"properties": {"enabled": {"const": false}}, "required": ["enabled"]}},
            "required": ["turbo"]
          },
          "then": {"properties": {"model": {"const": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"}}}
        }
      ]
    }
  }
}
