{
  "type": "object",
  "required": ["ready_root"],
  "additionalProperties": false,
  "properties": {
    "ready_root": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "modes", "bundle"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["image", "video", "audio"]},
          "modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "bundle": {"type": "string", "minLength": 1},
          "needs": {"type": "array"},
          "binds": {"type": "object"},
          "defaults": {"type": "object"},
          "default_for": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "mode", "priority"],
              "additionalProperties": false,
              "properties": {
                "kind": {"enum": ["image", "video", "audio"]},
                "mode": {"type": "string", "minLength": 1},
                "priority": {"type": "integer"}
              }
            }
          }
        }
      }
    },
    "build": {"type": "string", "pattern": "^[^:]+\\.py:[A-Za-z_]\\w*$"},
    "finalize": {"type": "string", "pattern": "^[^:]+\\.py:[A-Za-z_]\\w*$"}
  }
}
