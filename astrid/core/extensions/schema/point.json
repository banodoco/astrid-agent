{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extension point manifest (<pack>/extensions/points/<name>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "version", "min_supported", "side", "cardinality", "effects_allowed", "protocol"],
  "properties": {
    "description": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "min_supported": {"type": "integer", "minimum": 1},
    "side": {"enum": ["client", "agent"]},
    "cardinality": {"enum": ["many", "one"]},
    "effects_allowed": {
      "oneOf": [
        {"type": "array", "items": {"enum": ["none", "read", "edit"]}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutates"],
          "properties": {
            "mutates": {"type": "boolean"},
            "io": {"type": "array", "items": {"enum": ["media.read"]}, "uniqueItems": true}
          }
        }
      ]
    },
    "protocol": {"type": "string", "minLength": 1},
    "schema": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
    "harness": {"type": "string", "minLength": 1},
    "docs": {"type": "string", "minLength": 1},
    "template": {"type": "string", "minLength": 1}
  }
}
