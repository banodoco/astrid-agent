{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/pack/v3/pack.json",
  "title": "Astrid canonical pack manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^.*\\S.*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "experimental",
        "deprecated"
      ]
    },
    "visibility": {
      "enum": [
        "visible",
        "hidden"
      ]
    },
    "domain": {
      "enum": [
        "general",
        "development",
        "editorial",
        "generation",
        "infrastructure",
        "integration",
        "media",
        "system"
      ]
    },
    "stability": {
      "enum": [
        "stable",
        "experimental",
        "deprecated"
      ]
    },
    "support": {
      "enum": [
        "project",
        "core",
        "community"
      ]
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alias"
      }
    },
    "agent": {
      "type": "object"
    },
    "documentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "skill"
            },
            "path": {
              "const": "docs/SKILL.md"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "agents"
            },
            "path": {
              "const": "AGENTS.md"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "none"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "astrid_version": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "authoring_only": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authoring"
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "$ref": "#/$defs/non_blank"
          },
          "invocation": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "python"
                  },
                  "path": {
                    "$ref": "#/$defs/relative_path"
                  },
                  "function": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "function"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "command"
                  },
                  "command": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "argv": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/non_blank"
                        }
                      },
                      "cwd": {
                        "$ref": "#/$defs/non_blank"
                      },
                      "env": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "input_args": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "input": {
                              "$ref": "#/$defs/non_blank"
                            },
                            "flag": {
                              "$ref": "#/$defs/non_blank"
                            },
                            "repeatable": {
                              "type": "boolean"
                            },
                            "optional": {
                              "type": "boolean"
                            },
                            "before": {
                              "$ref": "#/$defs/non_blank"
                            }
                          },
                          "required": [
                            "input"
                          ]
                        }
                      }
                    },
                    "required": [
                      "argv"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "command"
                ]
              }
            ]
          },
          "inputs": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/non_blank"
                    },
                    "type": {
                      "enum": [
                        "boolean",
                        "directory",
                        "file",
                        "html",
                        "integer",
                        "json",
                        "number",
                        "path",
                        "string"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "placeholder": {
                      "$ref": "#/$defs/non_blank"
                    },
                    "artifact_type": {
                      "$ref": "#/$defs/non_blank"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "default": {}
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "oneOf": [
                  {
                    "type": [
                      "object",
                      "boolean"
                    ]
                  },
                  {
                    "$ref": "#/$defs/relative_path"
                  }
                ]
              }
            ]
          },
          "outputs": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/non_blank"
                    },
                    "type": {
                      "enum": [
                        "boolean",
                        "directory",
                        "file",
                        "html",
                        "integer",
                        "json",
                        "number",
                        "path",
                        "string"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "placeholder": {
                      "$ref": "#/$defs/non_blank"
                    },
                    "artifact_type": {
                      "$ref": "#/$defs/non_blank"
                    },
                    "mode": {
                      "enum": [
                        "create",
                        "create_or_replace",
                        "mutate"
                      ]
                    },
                    "path_template": {
                      "$ref": "#/$defs/non_blank"
                    },
                    "extension": {
                      "$ref": "#/$defs/non_blank"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "oneOf": [
                  {
                    "type": [
                      "object",
                      "boolean"
                    ]
                  },
                  {
                    "$ref": "#/$defs/relative_path"
                  }
                ]
              }
            ]
          },
          "name": {
            "$ref": "#/$defs/non_blank"
          },
          "version": {
            "$ref": "#/$defs/non_blank"
          },
          "short_description": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/non_blank"
            },
            "uniqueItems": true
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resource"
            }
          },
          "cache": {
            "type": "object"
          },
          "isolation": {
            "type": "object"
          },
          "graph": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          },
          "external_runtime": {
            "type": "object"
          },
          "clip_kinds_supported": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/non_blank"
            },
            "uniqueItems": true
          },
          "pipeline_requirements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/non_blank"
            },
            "uniqueItems": true
          },
          "scoped_configs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/non_blank"
            },
            "uniqueItems": true
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "description",
          "invocation",
          "inputs",
          "outputs"
        ]
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {"const": "editor"},
              "entry": {"$ref": "#/$defs/relative_path"},
              "target": {"$ref": "#/$defs/non_blank"},
              "compatibility": {"type": ["string", "object"]},
              "resources": {
                "type": "array",
                "items": {"$ref": "#/$defs/resource"}
              }
            },
            "required": ["type", "entry"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {"const": "tool"},
              "entry": {"$ref": "#/$defs/relative_path"},
              "target": {"const": "astrid"},
              "compatibility": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"host": {"const": "1"}},
                "required": ["host"]
              },
              "resources": {
                "type": "array",
                "items": {"$ref": "#/$defs/resource"}
              }
            },
            "required": ["type", "entry", "target", "compatibility"]
          }
        ]
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "renderer",
              "planner",
              "finalizer",
              "element"
            ]
          },
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resource"
            }
          }
        },
        "required": [
          "type",
          "path"
        ]
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "format_version": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "$ref": "#/$defs/non_blank"
              }
            ]
          },
          "schema": {
            "oneOf": [
              {
                "type": [
                  "object",
                  "boolean"
                ]
              },
              {
                "$ref": "#/$defs/relative_path"
              }
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resource"
            }
          }
        },
        "required": [
          "format_version",
          "schema"
        ]
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "actions"
      ]
    },
    {
      "required": [
        "ui"
      ]
    },
    {
      "required": [
        "rendering"
      ]
    },
    {
      "required": [
        "documents"
      ]
    },
    {
      "required": [
        "documentation"
      ]
    },
    {
      "required": [
        "resources"
      ]
    }
  ],
  "$defs": {
    "non_blank": {
      "type": "string",
      "minLength": 1,
      "pattern": "^.*\\S.*$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*\\x00)(?!.*//)(?!.*(^|/)\\.($|/))(?!.*(^|/)\\.\\.($|/))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "const": "pack.yaml"
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/non_blank"
        },
        "access": {
          "$ref": "#/$defs/non_blank"
        },
        "services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_blank"
          }
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "alias",
        "canonical_id"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_-]*$"
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_-]*$"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "kind": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/non_blank"
        }
      }
    }
  }
}
