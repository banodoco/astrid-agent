{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admitted command-only timeline operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["point", "id", "label", "description", "inputs", "implementation"],
  "properties": {
    "point": {"const": "timeline.operation"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "function"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    }
  }
}
