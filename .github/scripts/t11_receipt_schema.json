{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T-11 installed-pack receipt and fail-closed observation gate",
  "type": "object",
  "required": ["status", "qualification", "phase", "observations"],
  "properties": {
    "status": {"const": "not-qualified"},
    "qualification": {"const": false},
    "phase": {"type": "string", "minLength": 1},
    "observations": {
      "type": "object",
      "required": [
        "requested_tuple",
        "schema_consumption",
        "composition_execution",
        "same_process_observer"
      ],
      "properties": {
        "requested_tuple": {"$ref": "#/$defs/tuple"},
        "schema_consumption": {"enum": ["observed", "unobserved", "ambiguous", "unavailable"]},
        "composition_execution": {"enum": ["observed", "unobserved", "ambiguous", "unavailable"]},
        "timeline_schema": {"$ref": "#/$defs/timelineSchema"},
        "same_process_observer": {
          "type": "object",
          "required": ["status", "qualification", "same_process_observation"],
          "properties": {
            "status": {"enum": ["observed", "refused-no-product-seam", "refused-no-authenticated-collection", "observer-failed"]},
            "qualification": {"type": "boolean"},
            "same_process_observation": {
              "type": "object",
              "required": ["schema_consumption", "composition_execution"],
              "properties": {
                "schema_consumption": {"type": "object", "required": ["status"]},
                "composition_execution": {"type": "object", "required": ["status"]}
              }
            },
            "composition_input_identity": {
              "type": "object",
              "required": ["archive_sha256", "resolved_input_inventory_sha256", "equal"],
              "properties": {"equal": {"const": true}}
            },
            "render_run_identity": {
              "type": "object",
              "required": ["status", "run_id"]
            },
            "process_run_correlation": {
              "type": "object",
              "required": ["status", "run_id"]
            },
            "direct_event_evidence": {"$ref": "#/$defs/directEvents"},
            "timeline_schema": {"$ref": "#/$defs/timelineSchema"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tuple": {
      "type": "object",
      "required": ["agent", "runtime", "app", "pinokio"],
      "properties": {
        "agent": {"$ref": "#/$defs/sha"},
        "runtime": {"$ref": "#/$defs/sha"},
        "app": {"$ref": "#/$defs/sha"},
        "pinokio": {"$ref": "#/$defs/sha"}
      }
    },
    "process": {
      "type": "object",
      "required": ["pid", "start_ticks", "boot_id"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "start_ticks": {"type": "integer", "minimum": 1},
        "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schemaEvent": {
      "type": "object",
      "required": ["event", "run_id", "monotonic_ns", "pid", "start_ticks", "boot_id", "schema_sha256", "schema_reader_origin_sha256"],
      "additionalProperties": false,
      "properties": {
        "event": {"const": "timeline_schema_consumed"},
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "monotonic_ns": {"type": "integer", "minimum": 1},
        "pid": {"type": "integer", "minimum": 1},
        "start_ticks": {"type": "integer", "minimum": 1},
        "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "schema_sha256": {"$ref": "#/$defs/digest"},
        "schema_reader_origin_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "timelineSchema": {
      "type": "object", "required": ["status"],
      "properties": {
        "status": {"enum": ["observed", "unobserved"]},
        "consumed_document_sha256": {"$ref": "#/$defs/digest"},
        "consuming_process": {"$ref": "#/$defs/process"},
        "schema_reader_origin_sha256": {"$ref": "#/$defs/digest"},
        "event_sha256": {"$ref": "#/$defs/digest"},
        "event": {"$ref": "#/$defs/schemaEvent"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "observed"}}, "required": ["status"]},
        "then": {"required": ["consumed_document_sha256", "consuming_process", "schema_reader_origin_sha256", "event_sha256", "event"]}
      }]
    },
    "directEvents": {
      "type": "object",
      "required": ["schema_event", "composition_event"],
      "properties": {
        "schema_event": {"$ref": "#/$defs/schemaEvent"},
        "composition_event": {
          "type": "object",
          "required": ["event", "run_id", "observed_at_monotonic_ns", "process", "composition"],
          "properties": {
            "event": {"const": "composition_executed"},
            "run_id": {"type": "string", "minLength": 1},
            "observed_at_monotonic_ns": {"type": "integer", "minimum": 0},
            "process": {"$ref": "#/$defs/process"},
            "composition": {
              "type": "object",
              "required": ["archive_sha256", "resolved_input_inventory_sha256", "loaded_bundle_sha256"],
              "properties": {
                "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "resolved_input_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "loaded_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "qualified"}}, "required": ["status"]},
      "then": {
        "properties": {
          "qualification": {"const": true},
          "observations": {
            "properties": {
              "schema_consumption": {"const": "observed"},
              "composition_execution": {"const": "observed"},
              "same_process_observer": {
                "properties": {
                  "status": {"const": "observed"},
                  "qualification": {"const": true},
                  "same_process_observation": {
                    "properties": {
                      "schema_consumption": {
                        "properties": {"status": {"const": "observed"}}
                      },
                      "composition_execution": {
                        "properties": {"status": {"const": "observed"}}
                      }
                    }
                  },
                  "composition_input_identity": {
                    "properties": {"equal": {"const": true}}
                  },
                  "render_run_identity": {
                    "properties": {"status": {"const": "observed"}}
                  },
                  "process_run_correlation": {
                    "properties": {"status": {"const": "observed"}}
                  }
                },
                "required": [
                  "composition_input_identity",
                  "render_run_identity",
                  "process_run_correlation",
                  "direct_event_evidence"
                ]
              }
            }
          }
        }
      },
      "else": {"properties": {"qualification": {"const": false}}}
    }
  ]
}
