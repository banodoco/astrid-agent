+@pytest.mark.integration  # needs sibling VibeComfy/Runtime checkout on sys.path
+@pytest.mark.parametrize("field,value,reason", [
+    ("source_digest", "revision", "binding source_digest does not match verified evidence"),
+    ("execution_identity", "different", "binding execution_identity does not match the residency digest"),
+    ("launch_generation", "different", "binding launch_generation does not match verified evidence"),
+    ("runtime_epoch", 1, "runtime_epoch is not verifiable on the attached path"),
+])
+def test_sdk_cpu_handoff_factory_rejects_unverified_binding_fields(tmp_path, monkeypatch, field, value, reason):
+    from dataclasses import replace
+    from astrid.core.generation.backends.vibecomfy import CheckoutServerAdapter, ComfyHostHooks
+    f = _sdk_cpu_session_fixture(tmp_path, monkeypatch)
+    binding = _sdk_cpu_session_binding(f.profile)
+    hook = CheckoutServerAdapter.open_host_session(binding=binding, hc03_profile=f.profile)
+    assert isinstance(hook, ComfyHostHooks)
+    assert hook.observe(binding=binding) == {"ok": True, "observed": True, "fenced": False}
+    with pytest.raises(ValueError, match=reason):
+        CheckoutServerAdapter.open_host_session(binding=replace(binding, **{field: value}), hc03_profile=f.profile)
+    assert f.controls == []
+
+
