[Unit]
Description=Astrid Runtime

[Service]
ExecStart="/astrid/versions/v1/py/bin/python" "-X" "utf8" "-I" "-c" "import json,os,re,stat,sys\nfrom dataclasses import dataclass\nfrom pathlib import Path\ndef linked(path: Path) -> bool:\n    if path.is_symlink():\n        return True\n    try:\n        # Path.is_junction is unavailable on the pinned Python 3.11. This\n        # also rejects other Windows reparse points before recursive copies.\n        attributes = getattr(path.lstat(), \"st_file_attributes\", 0)\n        return bool(attributes & getattr(stat, \"FILE_ATTRIBUTE_REPARSE_POINT\"))\n    except FileNotFoundError:\n        return False\n\ndef absolute(value: str | Path) -> Path:\n    path = Path(value).expanduser()\n    if not path.is_absolute():\n        raise ValueError(f\"An absolute path is required: {path}\")\n    path = Path(os.path.abspath(path))\n    for entry in (path, *path.parents):\n        if linked(entry):\n            raise ValueError(f\"Managed paths cannot contain links: {entry}\")\n    return path\n\ndef read_json(path: Path) -> dict:\n    if not path.exists():\n        return {}\n    value = json.loads(path.read_text(encoding=\"utf-8\"))\n    if not isinstance(value, dict):\n        raise ValueError(f\"Expected an object in {path}\")\n    return value\n\ndef version_id(value: str) -> str:\n    if not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9._-]{0,63}\", value):\n        raise ValueError(\"Invalid installation version identifier.\")\n    return value\n\ndef install_release(manifest: dict) -> int:\n    \"\"\"Return the validated decimal release from a staged version manifest.\"\"\"\n    release = manifest.get(\"release\", 0)\n    if type(release) is not int or release < 0:\n        raise ValueError(\"The install manifest release must be a nonnegative integer.\")\n    return release\n\ndef install_identity(version_root: Path) -> dict:\n    \"\"\"Derive a managed install's identity from its immutable manifest and marker.\"\"\"\n    managed_by = read_json(version_root.parent.parent / \"install.json\").get(\"managed_by\")\n    if managed_by not in {None, \"pinokio\"}:\n        raise ValueError(\"Invalid installation manager in install record.\")\n    return {\"release\": install_release(read_json(version_root / \"manifest.json\")),\n            \"managed_by\": managed_by}\n\n@dataclass(frozen=True)\nclass Version:\n    root: Path\n    python: Path\n    profile: Path\n    env: dict[str, str]\n    release: int = 0\n    managed_by: str | None = None\n\n    def __post_init__(self) -> None:\n        if type(self.release) is not int or self.release < 0:\n            raise ValueError(\"The install manifest release must be a nonnegative integer.\")\n        if self.managed_by not in {None, \"pinokio\"}:\n            raise ValueError(\"Invalid installation manager.\")\n        env = dict(self.env)\n        object.__setattr__(self, \"env\", env)\n        env[\"ASTRID_INSTALL_RELEASE\"] = str(self.release)\n        env[\"ASTRID_INSTALL_MANAGED_BY\"] = self.managed_by or \"\"\n\n    def document(self) -> dict:\n        return {\"root\": str(self.root), \"python\": str(self.python),\n                \"profile\": str(self.profile), \"env\": dict(self.env),\n                \"identity\": {\"release\": self.release, \"managed_by\": self.managed_by}}\n\n    @classmethod\n    def load(cls, value: dict) -> \"Version\":\n        python = Path(value[\"python\"])\n        absolute(python.parent)  # POSIX venv interpreters themselves are links.\n        root = absolute(value[\"root\"])\n        # Legacy reconstruction is read-only. Persist only after recovery and\n        # successful stop admission (or a healthy repair requiring no stop).\n        identity = value[\"identity\"] if \"identity\" in value else install_identity(root)\n        if not isinstance(identity, dict):\n            raise ValueError(\"Invalid installation identity in version record.\")\n        release, managed_by = identity.get(\"release\"), identity.get(\"managed_by\")\n        if type(release) is not int or release < 0 or managed_by not in {None, \"pinokio\"}:\n            raise ValueError(\"Invalid installation identity in version record.\")\n        return cls(root, python, absolute(value[\"profile\"]), value[\"env\"], release, managed_by)\n\ndef current(root: Path) -> Version | None:\n    pointer = root / \"current\"\n    if not pointer.exists():\n        return None\n    name = version_id(pointer.read_text(encoding=\"utf-8\").strip())\n    record = absolute(root / \"versions\" / name / \"version.json\")\n    # Removal can delete version metadata before a locked pointer is released.\n    # The service's retained selection can still finish uninstalling this root.\n    if not record.exists() and not linked(record):\n        return None\n    version = Version.load(read_json(record))\n    if version.root != root / \"versions\" / name:\n        raise ValueError(\"The current version points outside the managed directory.\")\n    return version\n\ndef launch_admission(version: Version, data: Path) -> bool:\n    \"\"\"Validate the selected managed launch; return whether it is activating.\n\n    The pending journal selects a version, never a process or stop authority.\n    This function is also embedded verbatim in the generated command prelude.\n    \"\"\"\n    if version.root.parent.name != \"versions\":\n        return False  # Source checkouts are outside the managed launch contract.\n    root = absolute(version.root.parent.parent)\n    path = absolute(root / \"update-transaction.json\")\n    try:\n        selected = current(root)\n        if selected is None or selected.document() != version.document():\n            raise ValueError(\"The managed launch is not the selected version.\")\n        if not path.exists():\n            return False\n        transaction = read_json(path)\n        if (transaction.get(\"format\") != \"astrid-install-update/v1\"\n                or not isinstance(transaction.get(\"operation_id\"), str)\n                or re.fullmatch(r\"[0-9a-f]{32}\", transaction[\"operation_id\"]) is None\n                or transaction.get(\"transaction_kind\") not in {None, \"app\", \"migration\"}\n                or absolute(transaction[\"data_root\"]) != absolute(data)):\n            raise ValueError(\"Invalid update journal identity.\")\n\n        realm = transaction.get(\"realm\")\n        if (not isinstance(realm, dict) or not isinstance(realm.get(\"realm_id\"), str)\n                or not realm[\"realm_id\"] or absolute(realm[\"realm_root\"]) != Path(realm[\"realm_root\"])):\n            raise ValueError(\"Invalid update workspace identity.\")\n        terminal = transaction.get(\"step\") in {\"complete\", \"rolled_back\"}\n\n        def retained(value):\n            candidate = Version.load(value)\n            folder = absolute(root / \"versions\" / version_id(candidate.root.name))\n            if (candidate.root != folder or not candidate.python.is_absolute()\n                    or not candidate.python.is_relative_to(folder)\n                    or not candidate.profile.is_relative_to(folder)\n                    or (\"identity\" in value and value[\"identity\"] != candidate.document()[\"identity\"])\n                    or any(not isinstance(k, str) or not isinstance(v, str) for k, v in value[\"env\"].items())\n                    or any(str(candidate.document()[key]) != value[key] for key in (\"root\", \"python\", \"profile\"))\n                    or ((not terminal or (folder / \"version.json\").exists())\n                        and Version.load(read_json(absolute(folder / \"version.json\"))).document() != candidate.document())):\n                raise ValueError(\"Invalid managed update version.\")\n            return candidate\n\n        old = retained(transaction[\"old\"])\n        candidate = retained(transaction[\"candidate\"]) if transaction.get(\"candidate\") else None\n        step = transaction.get(\"step\")\n        if step in {\"complete\", \"rolled_back\"}:\n            return False\n        allowed = candidate if step == \"switched\" else old if step == \"rollback_selected\" else None\n        if allowed is None or allowed.document() != version.document():\n            raise ValueError(\"The pending update does not permit this launch.\")\n        return True\n    except (OSError, ValueError, TypeError, KeyError, AttributeError) as exc:\n        action = (\"Choose Pinokio's Update button to finish it.\"\n                  if version.managed_by == \"pinokio\" else\n                  \"Run the install line to finish it: curl -fsSL https://astrid.haus/install | sh\"\n                  if os.name != \"nt\" else\n                  \"Run the install line to finish it: irm https://astrid.haus/install.ps1 | iex\")\n        raise ValueError(\"An Astrid update was interrupted; \" + action) from exc\n\nlaunch_admission(Version.load({'root': '/astrid/versions/v1', 'python': '/astrid/versions/v1/py/bin/python', 'profile': '/astrid/versions/v1/profile.json', 'env': {'ASTRID_INSTALL_MANAGED_BY': '', 'ASTRID_INSTALL_RELEASE': '0', 'PATH': '/astrid/tools:/usr/bin:/bin', 'PYTHONUTF8': '1'}, 'identity': {'release': 0, 'managed_by': None}}),Path('/astrid data'))\nos.environ.update({'ASTRID_INSTALL_MANAGED_BY': '', 'ASTRID_INSTALL_RELEASE': '0', 'PATH': '/astrid/tools:/usr/bin:/bin', 'PYTHONUTF8': '1'})\nfrom astrid_runtime.cli import main\nsys.exit(main(['run', '--profile', 'astrid', '--data-root', '/astrid data', '--source-manifest', '/astrid/versions/v1/profile.json']))"
Environment="ASTRID_INSTALL_MANAGED_BY="
Environment="ASTRID_INSTALL_RELEASE=0"
Environment="PATH=/astrid/tools:/usr/bin:/bin"
Environment="PYTHONUTF8=1"
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=90
StandardOutput="append:/logs/runtime-service.log"
StandardError="append:/logs/runtime-service.log"

[Install]
WantedBy=default.target
