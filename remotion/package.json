    "@remotion/google-fonts": "4.0.509",
    "@remotion/layout-utils": "4.0.509",
    "@remotion/media": "4.0.509",
    "@remotion/renderer": "4.0.509",
    "@remotion/three": "4.0.509",
    "@types/three": "0.185.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.509",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.509",
    "@types/node": "^25.6.0",
